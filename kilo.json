{
    "$schema": "https://app.kilo.ai/config.json",
    "model": "openrouter/typesafe/jev-router",
    "small_model": "openrouter/deepseek/deepseek-v4.1-flash",
    "memory_model": "openrouter/deepseek/deepseek-v4.1-flash",
    "subagent_depth": 1,
    "reasoning_display": "preview",
    "terminal_command_display": "collapsed",
    "indexing": {
        "enabled": true,
        "provider": "openrouter",
        "model": "openai/text-embedding-3-small",
        "vectorStore": "lancedb",
        "openrouter": {
            "apiKey": "{env:OPENROUTER_API_KEY}"
        },
        "lancedb": {},
        "searchMinScore": 0.4,
        "searchMaxResults": 12,
        "embeddingBatchSize": 60,
        "scannerMaxBatchRetries": 3
    },
    "skills": {
        "paths": [
            "~/.config/kilo/skills"
        ]
    },
    "sandbox": {
        "enabled": false,
        "network": "allow"
    },
    "mcp": {
        "jev": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@jkudish/jev-mcp"
            ],
            "environment": {
                "OPENROUTER_API_KEY": "{env:OPENROUTER_API_KEY}",
                "JEV_PROVIDER": "openrouter"
            },
            "enabled": true
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        }
    },
    "provider": {
        "openrouter": {
            "options": {
                "apiKey": "{env:OPENROUTER_API_KEY}",
                "setCacheKey": true
            },
            "models": {
                "typesafe/jev-router": {
                    "name": "Jev Router (Balanced Core Pool)",
                    "id": "typesafe/jev-router",
                    "tool_call": true,
                    "reasoning": true,
                    "attachment": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1000000,
                        "output": 32768
                    },
                    "headers": {
                        "X-OpenRouter-Metadata": "enabled"
                    },
                    "options": {
                        "provider": {
                            "allow_fallbacks": true,
                            "ignore": [
                                "azure"
                            ]
                        },
                        "plugins": [
                            {
                                "id": "jev-router",
                                "cost_tier": "medium",
                                "models": [
                                    "deepseek/deepseek-v4.1-flash",
                                    "openai/gpt-6-luna",
                                    "openai/gpt-6.1-terra",
                                    "openai/gpt-6.1-sol"
                                ],
                                "excluded_models": [
                                    "openai/gpt-6-astra*",
                                    "openai/gpt-5*",
                                    "anthropic/*",
                                    "google/*",
                                    "x-ai/*"
                                ]
                            }
                        ]
                    }
                },
                "jev-router-low": {
                    "name": "Jev Router (Low-Cost Fast)",
                    "id": "typesafe/jev-router",
                    "tool_call": true,
                    "reasoning": true,
                    "attachment": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1000000,
                        "output": 16384
                    },
                    "headers": {
                        "X-OpenRouter-Metadata": "enabled"
                    },
                    "options": {
                        "provider": {
                            "allow_fallbacks": true,
                            "ignore": [
                                "azure"
                            ]
                        },
                        "plugins": [
                            {
                                "id": "jev-router",
                                "cost_tier": "low",
                                "models": [
                                    "deepseek/deepseek-v4.1-flash",
                                    "openai/gpt-6-luna",
                                    "openai/gpt-6.1-terra"
                                ],
                                "excluded_models": [
                                    "openai/gpt-6-astra*",
                                    "openai/gpt-6.1-sol*",
                                    "openai/gpt-5*",
                                    "anthropic/*",
                                    "google/*",
                                    "x-ai/*"
                                ]
                            }
                        ]
                    }
                },
                "jev-router-high": {
                    "name": "Jev Router (High-Capability Plan & Debug)",
                    "id": "typesafe/jev-router",
                    "tool_call": true,
                    "reasoning": true,
                    "attachment": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1000000,
                        "output": 32768
                    },
                    "headers": {
                        "X-OpenRouter-Metadata": "enabled"
                    },
                    "options": {
                        "provider": {
                            "allow_fallbacks": true,
                            "ignore": [
                                "azure"
                            ]
                        },
                        "plugins": [
                            {
                                "id": "jev-router",
                                "cost_tier": "high",
                                "models": [
                                    "openai/gpt-6.1-terra",
                                    "openai/gpt-6.1-sol"
                                ],
                                "excluded_models": [
                                    "openai/gpt-6-astra*",
                                    "openai/gpt-5*",
                                    "anthropic/*",
                                    "google/*",
                                    "x-ai/*"
                                ]
                            }
                        ]
                    }
                },
                "deepseek/deepseek-v4.1-flash": {
                    "name": "DeepSeek V4.1 Flash (Scout & Mechanical Worker)",
                    "id": "deepseek/deepseek-v4.1-flash",
                    "options": {
                        "provider": {
                            "allow_fallbacks": true
                        }
                    }
                },
                "openai/gpt-6-luna": {
                    "name": "GPT-6 Luna (Fast Light Coding & Compaction)",
                    "id": "openai/gpt-6-luna",
                    "options": {
                        "provider": {
                            "allow_fallbacks": true,
                            "ignore": [
                                "azure"
                            ]
                        }
                    }
                },
                "openai/gpt-6.1-terra": {
                    "name": "GPT-6.1 Terra (Direct Implementation & Mid-Surgeon)",
                    "id": "openai/gpt-6.1-terra",
                    "options": {
                        "provider": {
                            "allow_fallbacks": true,
                            "ignore": [
                                "azure"
                            ]
                        }
                    }
                },
                "openai/gpt-6.1-sol": {
                    "name": "GPT-6.1 Sol (Direct Flagship)",
                    "id": "openai/gpt-6.1-sol",
                    "options": {
                        "provider": {
                            "allow_fallbacks": true,
                            "ignore": [
                                "azure"
                            ]
                        }
                    }
                },
                "google/gemini-4-argon": {
                    "name": "Gemini 4 Argon (Direct Deep Surgeon & Reasoning)",
                    "id": "google/gemini-4-argon",
                    "options": {
                        "provider": {
                            "allow_fallbacks": true
                        }
                    }
                },
                "anthropic/claude-sonnet-5.5": {
                    "name": "Claude Sonnet 5.5 (Direct Flagship, Auto-Cached)",
                    "id": "anthropic/claude-sonnet-5.5",
                    "options": {
                        "cache_control": {
                            "type": "ephemeral"
                        },
                        "provider": {
                            "only": [
                                "anthropic"
                            ]
                        }
                    }
                },
                "anthropic/claude-opus-5.5": {
                    "name": "Claude Opus 5.5 (Manual Only - Strict Opus, Auto-Cached)",
                    "id": "anthropic/claude-opus-5.5",
                    "options": {
                        "cache_control": {
                            "type": "ephemeral"
                        },
                        "provider": {
                            "only": [
                                "anthropic"
                            ]
                        }
                    }
                }
            }
        },
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (Local)",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "qwen3-coder:30b": {
                    "name": "Qwen3 Coder 30B (Local Inference - 32K Context)",
                    "tool_call": true,
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    }
                }
            }
        }
    },
    "agent": {
        "code": {
            "mode": "primary",
            "model": "openrouter/typesafe/jev-router"
        },
        "code-pinned": {
            "description": "Fixed-model primary coding mode (GPT-6.1 Terra) with native Code permissions, GPT system prompt, and apply_patch active for sustained single-model sessions.",
            "mode": "primary",
            "model": "openrouter/openai/gpt-6.1-terra",
            "permission": {
                "question": "allow",
                "suggest": "allow",
                "plan_enter": "allow"
            }
        },
        "plan": {
            "mode": "primary",
            "model": "openrouter/jev-router-high"
        },
        "debug": {
            "mode": "primary",
            "model": "openrouter/jev-router-high"
        },
        "ask": {
            "mode": "primary",
            "model": "openrouter/jev-router-low"
        },
        "compaction": {
            "model": "openrouter/openai/gpt-6-luna"
        },
        "title": {
            "model": "openrouter/deepseek/deepseek-v4.1-flash",
            "reasoning": {
                "effort": "low"
            }
        },
        "summary": {
            "model": "openrouter/deepseek/deepseek-v4.1-flash",
            "reasoning": {
                "effort": "low"
            }
        },
        "general": {
            "model": "openrouter/openai/gpt-6.1-terra",
            "permission": {
                "todowrite": "deny",
                "agent_manager": "deny"
            }
        },
        "explore": {
            "model": "openrouter/deepseek/deepseek-v4.1-flash",
            "steps": 10,
            "reasoning": {
                "effort": "low"
            }
        },
        "file-picker": {
            "description": "Fast read-only repository scout returning a structured path/symbol/contract inventory. Prefer native explore for general search; use file-picker when partitioning work across subagents.",
            "mode": "subagent",
            "model": "openrouter/deepseek/deepseek-v4.1-flash",
            "steps": 8,
            "reasoning": {
                "effort": "low"
            },
            "prompt": "{file:./prompts/file-picker.md}",
